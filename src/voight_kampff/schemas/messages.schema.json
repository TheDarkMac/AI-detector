{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voight-kampff:schema:messages",
  "title": "Messages du processus de travail Voight-Kampff",
  "description": "Une ligne JSON envoyée par le processus de travail au processus principal (ADR-0036, ES-04). Le premier message est l'état de l'isolation, le deuxième l'identification, le dernier la fin ; pour chaque partie du périmètre, les résultats de chaque module actif sont suivis de son message « module » (ADR-0062, ADR-0071). Les parties extraites viennent ensuite, annoncées par un message « extraction » (ADR-0224). Les objets transportés sont ceux du schéma du rapport, de même version.",
  "oneOf": [
    { "$ref": "#/$defs/isolation" },
    { "$ref": "#/$defs/identification" },
    { "$ref": "#/$defs/extraction" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/constat" },
    { "$ref": "#/$defs/non_menee" },
    { "$ref": "#/$defs/visualisation" },
    { "$ref": "#/$defs/module" },
    { "$ref": "#/$defs/versions" },
    { "$ref": "#/$defs/fin" }
  ],
  "$defs": {
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version_schema", "isolation"],
      "properties": {
        "type": { "const": "isolation" },
        "version_schema": { "const": "0.12.0" },
        "isolation": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/isolation" }
      }
    },
    "identification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parties"],
      "properties": {
        "type": { "const": "identification" },
        "parties": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/partie" }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parties extraites, envoyées une fois après les modules des parties reconnues, avant leurs propres résultats (ADR-0224).",
      "required": ["type", "parties"],
      "properties": {
        "type": { "const": "extraction" },
        "parties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/partie_extraite" }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observation"],
      "properties": {
        "type": { "const": "observation" },
        "observation": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/observation" }
      }
    },
    "constat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "constat"],
      "properties": {
        "type": { "const": "constat" },
        "constat": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/constat" }
      }
    },
    "non_menee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "non_menee"],
      "properties": {
        "type": { "const": "non_menee" },
        "non_menee": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/non_menee" }
      }
    },
    "visualisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "visualisation"],
      "properties": {
        "type": { "const": "visualisation" },
        "visualisation": {
          "oneOf": [
            {
              "$ref": "urn:voight-kampff:schema:rapport#/$defs/visualisation_image",
              "required": ["donnees", "empreinte"]
            },
            { "$ref": "urn:voight-kampff:schema:rapport#/$defs/visualisation_tableau" }
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "module", "partie", "applicable"],
      "properties": {
        "type": { "const": "module" },
        "module": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/identifiant" },
        "partie": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/entier_strictement_positif" },
        "applicable": { "type": "boolean" }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dependances"],
      "properties": {
        "type": { "const": "versions" },
        "dependances": {
          "type": "array",
          "items": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/dependance" }
        }
      }
    },
    "fin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "empreinte"],
      "properties": {
        "type": { "const": "fin" },
        "empreinte": { "$ref": "urn:voight-kampff:schema:rapport#/$defs/empreinte" }
      }
    }
  }
}
